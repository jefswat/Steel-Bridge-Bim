<Window x:Class="SBM.App.Editors.ElevationCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elevation Check" Width="1380" Height="800" MinWidth="1000" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#FF1F1F1F">
    <DockPanel Background="#FF1F1F1F">
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelHeaderBrush}" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Copy Selected" Width="120" Margin="0,0,8,0" Click="OnCopy" ToolTip="Copy this calculation as text (paste into email, Excel or a calc sheet)"/>
                    <Button Content="Export All…" Width="110" Margin="0,0,8,0" Click="OnExport" ToolTip="Every bearing: text report (.txt) or one row per step (.csv)"/>
                    <Button Content="Close" Width="90" IsCancel="True" Click="OnClose"/>
                </StackPanel>
                <TextBlock x:Name="Summary" Foreground="#FFDDDDDD" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="540" MinWidth="300"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Text="Bearings — select one to see its calculation"/>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="10,8" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="Any point: finished grade, or girder elevations at a station" Foreground="#FFDDDDDD" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Station" VerticalAlignment="Center" Margin="0,0,10,4"/>
                            <TextBox x:Name="StaBox" Grid.Column="1" Margin="0,0,0,4" ToolTip="e.g. 21+50.00"/>
                            <TextBlock Grid.Row="1" Text="Offset" VerticalAlignment="Center" Margin="0,0,10,4"/>
                            <TextBox x:Name="OffBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" ToolTip="Right positive, e.g. -12'-6&quot; or 12.5"/>
                            <TextBlock Grid.Row="2" Text="Girder" VerticalAlignment="Center" Margin="0,0,10,4"/>
                            <ComboBox x:Name="GirderBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                                      ToolTip="Pick a girder to use its offset at that station and continue the chain down to bottom of steel"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Calculate" Width="100" Click="OnCalculate" IsDefault="True"/>
                                <TextBlock x:Name="CalcError" Foreground="{StaticResource ErrorBrush}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <DataGrid x:Name="BearingGrid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" SelectionMode="Single"
                          SelectionChanged="OnBearingSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Support" Binding="{Binding Support}"/>
                        <DataGridTextColumn Header="Girder" Binding="{Binding Girder}"/>
                        <DataGridTextColumn Header="Station" Binding="{Binding Station}"/>
                        <DataGridTextColumn Header="Top of Deck" Binding="{Binding Deck}"/>
                        <DataGridTextColumn Header="Bearing Seat" Binding="{Binding Seat}"/>
                        <DataGridTextColumn Header="Check" Binding="{Binding Status}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrushDark}"/>
            <DockPanel Grid.Column="2">
                <TextBlock x:Name="ChainTitle" DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" FontSize="14"/>
                <TextBlock x:Name="ChainLocation" DockPanel.Dock="Top" Foreground="{StaticResource MutedText}" Margin="10,6,10,2"/>
                <ItemsControl x:Name="ChecksList" DockPanel.Dock="Bottom" Margin="10,6,10,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Icon}" Foreground="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#FFDDDDDD"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DataGrid x:Name="StepGrid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" SelectionMode="Extended"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FF333337">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Step" Binding="{Binding Item}" Width="210" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="FontFamily" Value="Consolas"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Elevation" Binding="{Binding Elevation}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="230">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FF8CC4FF"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="How it was calculated" Binding="{Binding Basis}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#FFC8C8C8"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
