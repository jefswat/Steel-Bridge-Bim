<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SBM.Api\SBM.Api.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>sbm</AssemblyName>
    <RootNamespace>SBM.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plan-sheet link rules, found by CompanionDatabase.FindLinksFile for models opened outside samples\plans. -->
    <None Include="..\..\samples\plans\sheet-links-*.json" Link="plans\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
