# Build output
bin/
obj/
.vs/
*.user
TestResults/

# Published program and plan PDFs (regenerable / large)
dist/

# Scratch work (scripts, rasters, snapshots, test models, PDF text cache)
temp/

# Generated exports
*.ifc
*.ifczip
*.dxf
*.dwg
*.png
!docs/**/*.png

# Script run logs
samples/plans/*.log

# Agent worktrees
.worktrees/

# Companion database + split plan pages (regenerable)
*.sqlite
*.sqlite-journal
**/plans/*/p[0-9][0-9][0-9].*
**/plans/*/sheets.json

# Asset folders of companion databases (photos, documents, calcs referenced by <model>.sqlite; user data, back them up with the database)
*_assets/

# QC pilot: program copies and model inputs (regenerable); results and reports are kept
qc/bin/
qc/*/inputs/
