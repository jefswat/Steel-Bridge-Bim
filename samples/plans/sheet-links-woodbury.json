{
  // Plan sheet links of the Woodbury model (Iowa DOT Design 817, I-29 NB over Floyd Blvd, stage 1; PPC BTD beams).
  // Format: see sheet-links-i80-rampg.json (header) and docs/API.md "Companion database". Sheet index and families:
  // docs/plan-data/woodbury-i29-floyd/INDEX.md (PDF page p = design sheet p-2 for pages 3-44).
  // Hierarchy in this model: unit > superstructure > prestressed girder (assembly: beam + strands) | cross frame group > cross frame
  //   (steel diaphragm: channel, gussets, fillers, bolts) | bearing pad; unit > deck > deck slab. The substructure of this model is
  //   disabled (Substructure.Enabled = false) and the concrete diaphragms are not in the database yet, so the pier / abutment rules
  //   below link the bearing pads at that support and are ready for the pier / abutment parts when they are generated.

  "models": [ "Woodbury I-29 NB over Floyd.sbm" ],
  "planFolders": [ "plans", "C:/SBMData" ],

  "planSets": [
    { "id": "design-817", "pdf": "Woodbury 0817*.pdf", "bridgeGroup": "I-29 NB over Floyd Blvd - Stage 1",
      "sheets": [
