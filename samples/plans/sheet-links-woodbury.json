  "administrative": [ "^TITLE SHEET", "^REVISION SHEET", "^PACKAGING OVERVIEW" ],

  "rules": [
    { "id": "general-notes", "sheets": "^(ESTIMATED QUANTITIES|SUMMARY OF ITEMIZED QUANTITIES|GENERAL NOTES)\\b", "role": "general",
      "basis": "General notes, estimated and itemized quantities", "target": [ { "level": "unit" } ] },
    { "id": "situation", "sheets": "^SITUATION PLAN", "role": "general", "basis": "Situation plan: curve data, profile, superelevation",
      "target": [ { "level": "alignment", "bridge_group": "CL I-29" }, { "level": "unit" } ] },
    { "id": "staking", "sheets": "^STAKING DIAGRAM", "role": "general", "basis": "Staking diagram: support lines and beam layout",
      "target": [ { "level": "unit" } ] },
    { "id": "staging", "sheets": "^CONSTRUCTION STAGING", "role": "general", "basis": "Construction staging (stage 1 of the NB bridge)",
      "target": [ { "level": "unit" } ] },

    { "id": "pier-details", "sheets": "^PIER DETAILS", "basis": "Pier caps, columns, footings, piles and reinforcing (bar lists p.12)",
      "target": [ { "level": "part", "category": "pier" }, { "level": "element", "category": "bearing pad", "support": "Pier%" } ] },
    { "id": "pier-aesthetics", "sheets": "^PIER AESTHETIC DETAILS", "basis": "Pier treatment (thin veneer brick)",
      "target": [ { "level": "group", "category": [ "cap group", "column group" ], "support": "Pier%" } ] },
    { "id": "south-abutment", "sheets": "^SOUTH ABUTMENT DETAILS", "basis": "South (integral) abutment: cap, piles, end diaphragm, beam seats",
      "target": [ { "level": "part", "category": "abutment", "support": "S%Abut%" }, { "level": "element", "category": "bearing pad", "support": "S%Abut%" } ] },
    { "id": "north-abutment", "sheets": "^NORTH ABUTMENT DETAILS", "basis": "North (integral) abutment: cap, piles, end diaphragm, beam seats",
      "target": [ { "level": "part", "category": "abutment", "support": "N%Abut%" }, { "level": "element", "category": "bearing pad", "support": "N%Abut%" } ] },
    { "id": "abutment-piles", "sheets": "^ABUTMENT PILE PLAN", "basis": "Abutment pile plan, step diagram and seat elevations",
      "target": [ { "level": "part", "category": "abutment" }, { "level": "element", "category": "bearing pad", "support": "%Abut%" } ] },

    { "id": "typical-section", "sheets": "^SUPERSTRUCTURE DETAILS", "pages": [ 18, 19 ], "basis": "Typical section: deck, haunch, beam spacing, barrier",
      "target": [ { "level": "part", "category": "deck" }, { "level": "assembly", "category": "prestressed girder" } ] },
    { "id": "camber", "sheets": "^SUPERSTRUCTURE DETAILS", "pages": [ 24 ], "basis": "Beam camber data, deck thickness at the beams",
      "target": [ { "level": "assembly", "category": "prestressed girder" }, { "level": "part", "category": "deck" } ] },
    { "id": "longitudinal-section", "sheets": "^LONGITUDINAL SECTION", "basis": "Longitudinal section: spans, top of pier details, bearing pads",
      "target": [ { "level": "part", "category": "superstructure" } ] },
    { "id": "beam-layout", "sheets": "^BEAM LAYOUT", "basis": "Beam layout: beam lines, work points, diaphragm locations",
      "target": [ { "level": "part", "category": "superstructure" } ] },
    { "id": "deck", "sheets": "^(DECK PLAN & REINFORCEMENT|TRANSVERSE DECK REINFORCING)", "basis": "Deck plan, reinforcing and placement",
      "target": [ { "level": "part", "category": "deck" } ] },
    { "id": "quantities-bar-list", "sheets": "^DECK, ABUT\\. & DIAPH\\. QUANTITIES", "basis": "Deck / abutment / diaphragm bar list and quantities",
      "target": [ { "level": "part", "category": [ "deck", "abutment" ] } ] },
    { "id": "beam-data", "sheets": "^(P\\.P\\.C\\. BEAM DATA SHEET|BTD BEAM DETAILS)", "basis": "PPC beam data: camber, bearing seats, beam bar list",
      "target": [ { "level": "assembly", "category": "prestressed girder" }, { "level": "element", "category": "bearing pad" } ] },
    { "id": "btd55", "sheets": "^BTD55 BEAM DETAILS", "basis": "BTD55 standard beam: section, strand pattern (span 1)",
      "target": [ { "level": "assembly", "category": "prestressed girder", "name": "%-S1" } ] },
    { "id": "btd105", "sheets": "^BTD105 BEAM DETAILS", "basis": "BTD105 standard beam: section, strand pattern (span 2)",
      "target": [ { "level": "assembly", "category": "prestressed girder", "name": "%-S2" } ] },
    { "id": "btd60", "sheets": "^BTD60 BEAM DETAILS", "basis": "BTD60 standard beam: section, strand pattern (span 3)",
      "target": [ { "level": "assembly", "category": "prestressed girder", "name": "%-S3" } ] },
    { "id": "steel-diaphragms", "sheets": "^STEEL DIAPHRAGM DETAILS", "basis": "Steel intermediate diaphragms (std 1036-BTD): members, bolt holes",
      "target": [ { "level": "group", "category": "cross frame group" } ] },
    { "id": "top-of-deck", "sheets": "^TOP OF DECK ELEVATIONS", "basis": "Top of deck elevations",
      "target": [ { "level": "part", "category": "deck" } ] },
    { "id": "haunch", "sheets": "^HAUNCH DATA DETAILS", "basis": "Haunch data along the beams",
      "target": [ { "level": "assembly", "category": "prestressed girder" }, { "level": "part", "category": "deck" } ] },
    { "id": "barrier", "sheets": "^BARRIER RAIL DETAILS", "basis": "Barrier rail profile, reinforcing and bar list",
      "target": [ { "level": "group", "category": "barrier group" }, { "level": "element", "category": "barrier" } ] },
    { "id": "lighting", "sheets": "^LIGHTING DETAILS", "basis": "Lighting",
      "target": [ { "level": "group", "category": "lighting" } ] }
  ],

  "hints": [
    { "sheets": "PIER DETAILS|PIER AESTHETIC", "suggests": "Piers: the model's substructure is disabled (Substructure.Enabled = false); only the bearing pads at the piers link here." },
    { "sheets": "ABUTMENT DETAILS", "suggests": "Abutments: the model's substructure is disabled; only the bearing pads link here." },
    { "sheets": "LIGHTING", "suggests": "Lighting (poles, conduit, junction boxes) is not in this model." },
    { "sheets": "BARRIER RAIL", "suggests": "Barrier: not generated in this model (Deck.Barrier.Type = None)." },
    { "sheets": "SLOPE PROTECTION", "suggests": "Slope protection under the bridge: no earthwork / slope-protection elements." },
    { "sheets": "SUBDRAIN", "suggests": "Subdrain behind the abutments: not modeled." },
    { "sheets": "BACKFILL", "suggests": "Abutment backfill: not modeled." },
    { "sheets": "TEXTURE", "suggests": "Concrete texture / rustication (surface treatment): not modeled." },
    { "sheets": "SOIL PROFILE", "suggests": "Soil borings: no geotechnical elements." }
  ]
}
