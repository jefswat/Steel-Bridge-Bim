    {
      "id": "foundation-layout",
      "sheets": "^GENERAL DRAWING FOUNDATION LAYOUT - UNIT 5",
      "role": "general",
      "basis": "Bent stations, footing plans (51'-0 x 36'-0, octagon 58'-6 at bents 23 / 24), pile counts and batter (piers.csv, p251-253)",
      "target": [
        {
          "level": "element",
          "category": "footing"
        }
      ]
    },
    {
      "id": "typical-section",
      "sheets": "^TYPICAL SECTION$",
      "basis": "42'-7 box, 40'-0 roadway, parapets (not modeled)",
      "target": [
        {
          "level": "group",
          "category": "segmental box"
        }
      ]
    },
    {
      "id": "segment-designations",
      "sheets": "^SEGMENT DESIGNATIONS",
      "basis": "Segment layout per span (12 / 13 x 14'-0, 5'-0 bent halves, 4'-0 / 3'-6 closure joints, end segments)",
      "target": [
        {
          "level": "assembly",
          "category": "segmental cantilever"
        },
        {
          "level": "part",
          "category": [
            "closure joint",
            "end segment"
          ]
        }
      ]
    },
    {
      "id": "geometry-control",
      "sheets": "^GEOMETRY CONTROL",
      "basis": "Box square to the top: DIM A / B, box height and slopes at bents 18-29; cross slope direction (looking upstation)",
      "target": [
        {
          "level": "group",
          "category": "segmental box"
        },
        {
          "level": "part",
          "category": "bent segment"
        }
      ]
    },
    {
      "id": "segment-dimensions",
      "sheets": "^SEGMENT DIMENSIONS",
      "basis": "Box section and the variable depth / bottom slab table (sections 1-12)",
      "target": [
        {
          "level": "part",
          "category": [
            "typical segment",
            "closure joint"
          ]
        }
      ]
    },
    {
