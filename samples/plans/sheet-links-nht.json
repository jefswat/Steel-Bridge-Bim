      "target": [ { "level": "alignment", "bridge_group": "CL NHT (TRAILCLNEW)" } ] },
    { "id": "layout", "sheets": "^BRIDGE LAYOUT", "role": "general", "basis": "Bridge layout: supports, units, spans, joints, rails, profile grade",
