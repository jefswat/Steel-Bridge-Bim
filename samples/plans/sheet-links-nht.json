    { "id": "typical-approach", "sheets": "^TYPICAL SECTIONS APPROACH SPANS", "basis": "Approach typical section: 15'-8 deck, 8 1/2 slab, 2 Tx28, 1% crown",
      "target": [ { "level": "part", "category": "deck" }, { "level": "assembly", "category": "prestressed girder" } ] },
    { "id": "foundation-layout", "sheets": "^FOUNDATION LAYOUT", "basis": "Foundation schedule: shaft stations, offsets, diameters, pier-line bearings",
      "target": [ { "level": "element", "category": "drilled shaft" } ] },
    { "id": "abutment-1", "sheets": "^ABUTMENT 1 DETAILS", "basis": "Abutment 1: cap, backwall, seats, 2 x 36\" shafts, control elevations",
      "target": [ { "level": "part", "category": "abutment", "support": "Abutment 1" }, { "level": "element", "category": "bearing pad", "support": "Abutment 1" } ] },
    { "id": "abutment-16", "sheets": "^ABUTMENT 16 DETAILS", "basis": "Abutment 16: cap, backwall, seats, 2 x 36\" shafts, control elevations",
      "target": [ { "level": "part", "category": "abutment", "support": "Abutment 16" }, { "level": "element", "category": "bearing pad", "support": "Abutment 16" } ] },
    { "id": "piers-typical", "sheets": "^PIERS 2-5, 8, 9, 12 & 13 DETAILS", "basis": "Single-column piers: cap, seats, 3'-0 column, 48\" shaft tables",
      "target": [ { "level": "part", "category": "pier", "support": [ "Pier 2", "Pier 3", "Pier 4", "Pier 5", "Pier 8", "Pier 9", "Pier 12", "Pier 13" ] } ] },
    { "id": "piers-wide", "sheets": "^PIERS 6 & 7, 14 & 15 DETAILS", "basis": "Single-column piers with offset 3'-0 x 4'-0 column: cap, seats, 48\" shaft tables",
      "target": [ { "level": "part", "category": "pier", "support": [ "Pier 6", "Pier 7", "Pier 14", "Pier 15" ] } ] },
    { "id": "arch-pier-shafts", "sheets": "^DRILLED SHAFT DETAILS ARCH PIERS", "basis": "Arch pier 6'-6 drilled shafts: tops, tips, reinforcement",
      "target": [ { "level": "element", "category": "drilled shaft", "support": [ "Pier 10", "Pier 11" ] } ] },
    { "id": "arch-pier-shaft-bars", "sheets": "^DRILLED SHAFT DETAILS ARCH PIERS", "basis": "Arch pier shaft cage: 28 #11, #7 hoops at 6\" max (4'-3\" lap), V1 dowels to match the column bars (rebar-nht-sub.csx)",
      "target": [ { "level": "group", "category": "footing group", "support": [ "Pier 10", "Pier 11" ] } ] },
    { "id": "arch-piers", "sheets": "^ARCH PIERS 10 AND 11 (ELEVATIONS AND SECTIONS|REINFORCEMENT|DETAILS)", "basis": "Hammerhead arch piers: cap, column, arch and approach pedestals, elevation table, bar list",
      "target": [ { "level": "part", "category": "pier", "support": [ "Pier 10", "Pier 11" ] } ] },
