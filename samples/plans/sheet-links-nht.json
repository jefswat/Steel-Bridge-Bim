  "rules": [
    { "id": "general-notes", "sheets": "^(BRIDGE GENERAL NOTES|BRIDGE SUMMARY OF QUANTITIES)", "role": "general",
      "basis": "Bridge general notes (materials, covers, standards) and summary of quantities / approach bearing seat elevations (p.91)",
      "target": [ { "level": "unit" } ] },
    { "id": "alignment", "sheets": "^(HORIZONTAL ALIGNMENT DATA|VERTICAL ALIGNMENT DATA|SURVEY CONTROL)", "role": "general",
