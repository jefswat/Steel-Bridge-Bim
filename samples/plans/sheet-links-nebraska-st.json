  "administrative": [ "^TITLE SHEET", "^PACKAGING OVERVIEW" ],

  "rules": [
    { "id": "general-notes", "sheets": "^(ESTIMATED QUANTITIES|SUMMARY OF ITEMIZED QUANTITIES|GENERAL NOTES)", "role": "general",
      "basis": "General notes (weathering steel, HPS 70W at the cap, jacking, painting girder A), estimated quantities and the summary of itemized quantities", "target": [ { "level": "unit" } ] },
    { "id": "situation", "sheets": "^SITUATION PLAN", "role": "general", "basis": "Situation plan: curve data, profile, superelevation, berm table, GPS location",
      "target": [ { "level": "alignment", "bridge_group": "CL Nebraska St. Ramp B" }, { "level": "unit" } ] },
    { "id": "staking", "sheets": "^STAKING DIAGRAM", "role": "general", "basis": "Staking diagram: support lines to the chord between abutments, footing positions (pier footings, the L-shaped abutment footing outline 10'-7 1/2)",
      "target": [ { "level": "unit" }, { "level": "group", "category": "footing group" }, { "level": "part", "category": "abutment" } ] },

    { "id": "pier-1", "sheets": "^PIER NO\\. 1 DETAILS", "basis": "Pier 1: cap, pedestals, maskwalls (cap end walls), columns, footings, piles and reinforcing",
      "target": [ { "level": "part", "category": "pier", "support": "Pier 1" }, { "level": "element", "category": "maskwall", "support": "Pier 1" },
                 { "level": "group", "category": "footing group", "support": "Pier 1" }, { "level": "element", "category": [ "footing", "pile" ], "support": "Pier 1" } ] },
    { "id": "pier-2", "sheets": "^PIER NO\\. 2 DETAILS", "basis": "Pier 2: two turned columns, pedestals under the cap bearings, footings, piles (no concrete cap)",
      "target": [ { "level": "part", "category": "pier", "support": "Pier 2" },
                 { "level": "group", "category": "footing group", "support": "Pier 2" }, { "level": "element", "category": [ "footing", "pile" ], "support": "Pier 2" } ] },
    { "id": "pier-notes", "sheets": "^PIER DETAILS \\(NOTES", "basis": "Pier notes, footing and pile notes, uplift anchors, bar lists",
      "target": [ { "level": "element", "category": [ "footing", "pile", "maskwall" ], "support": "Pier%" } ] },
    { "id": "pier-1-aesthetics", "sheets": "^PIER NO\\. 1 AESTHETIC DETAILS", "basis": "Integral thin veneer brick on the pier 1 columns and cap (Details A / B, mockup)",
      "target": [ { "level": "element", "category": "thin brick", "support": "Pier 1" }, { "level": "group", "category": "surface treatment", "name": "%thin veneer brick%" } ] },
    { "id": "pier-2-aesthetics", "sheets": "^PIER NO\\. 2 AESTHETIC DETAILS", "basis": "Integral thin veneer brick on the pier 2 columns",
      "target": [ { "level": "element", "category": "thin brick", "support": "Pier 2" } ] },

    { "id": "south-abutment", "sheets": "^SOUTH ABUTMENT DETAILS", "basis": "South stub abutment: footing, backwall, steps, piles",
      "target": [ { "level": "part", "category": "abutment", "support": "S%Abut%" }, { "level": "element", "category": [ "footing", "pile" ], "support": "S%Abut%" } ] },
    { "id": "north-abutment", "sheets": "^NORTH ABUTMENT DETAILS", "basis": "North stub abutment: footing, backwall, steps, piles",
      "target": [ { "level": "part", "category": "abutment", "support": "N%Abut%" }, { "level": "element", "category": [ "footing", "pile" ], "support": "N%Abut%" } ] },
    { "id": "abutment-piles", "sheets": "^ABUTMENT PILING LAYOUT", "basis": "Abutment pile plan and notes",
      "target": [ { "level": "element", "category": "pile", "support": "%Abut%" } ] },
    { "id": "abutment-quantities", "sheets": "^ABUTMENT QUANTITIES", "basis": "Abutment bar lists and concrete quantities",
      "target": [ { "level": "part", "category": "abutment" } ] },

    { "id": "typical-section", "sheets": "^SUPERSTRUCTURE DETAILS", "basis": "Typical section (std 4305 mod.), superstructure notes, section near pier 2",
      "target": [ { "level": "part", "category": "deck" }, { "level": "element", "category": "deck slab" }, { "level": "group", "category": "girder" },
                 { "level": "bar", "category": "rebar", "mark": [ "5d2", "5e5", "5e6" ] } ] },
    { "id": "longitudinal-section", "sheets": "^LONGITUDINAL SECTION", "basis": "Longitudinal section: spans, bearing settings",
      "target": [ { "level": "part", "category": "superstructure" } ] },
    { "id": "framing", "sheets": "^FRAMING PLAN", "basis": "Framing plan: girders, cross frame lines (spacing along girders A / D), splices, stiffener locations, flange deflector callouts, girder data and radius data, limits of painting",
      "target": [ { "level": "part", "category": "superstructure" }, { "level": "assembly", "category": [ "girder field section", "cross frame", "flange deflector" ] },
                 { "level": "part", "category": [ "bearing stiffener", "connection stiffener", "intermediate stiffener" ] } ] },
    { "id": "girder-elevation", "sheets": "^GIRDER ELEVATION", "basis": "Girder elevation: flange / web plates, studs (equal-space zones), splice locations, tension / compression zones",
      "target": [ { "level": "group", "category": "girder" }, { "level": "group", "category": "stud group" } ] },
    { "id": "integral-cap", "sheets": "^INTEGRAL STEEL PIER CAP", "basis": "Integral steel pier cap: plan, elevation, camber, notes, details",
      "target": [ { "level": "group", "category": "integral steel cap group" }, { "level": "assembly", "category": [ "integral steel pier cap", "pier cap connection" ] },
                 { "level": "bar", "category": "rebar", "mark": [ "5d2", "5e5", "5e6" ] } ] },
    { "id": "integral-cap-connection", "sheets": "^INTEGRAL STEEL PIER CAP DETAILS \\(GIRDER SPLICE", "basis": "Girder splice over the cap (end plates, connector plates, tapered fill), handholes, fabrication tolerances",
      "target": [ { "level": "assembly", "category": "pier cap connection" }, { "level": "part", "category": [ "end plate", "handhole cover", "handhole backing plate" ] } ] },
    { "id": "integral-cap-sections", "sheets": "^INTEGRAL STEEL PIER CAP DETAILS \\(SECTIONS", "basis": "Cap sections A-A / B-B / C-C, cover plates (Details B / C, Views E-E / F-F), mesh screen",
      "target": [ { "level": "part", "category": [ "cover plate", "wire mesh screen" ] }, { "level": "part", "category": "bearing stiffener", "support": "Pier 2" } ] },
    { "id": "welding", "sheets": "^WELDING DETAILS", "basis": "Welding details (std 1021W mod.): bearing / jacking / cross frame / intermediate stiffener sizes and welds, flange-to-web welds, flange transitions, radiography, shear stud detail, flange deflector details (6)",
      "target": [ { "level": "group", "category": [ "weld group", "stud group" ] }, { "level": "part", "category": [ "bearing stiffener", "connection stiffener", "intermediate stiffener" ] },
                 { "level": "assembly", "category": "flange deflector" } ] },
    { "id": "cross-frames", "sheets": "^CROSS FRAME DETAILS", "basis": "Abutment and pier 1 / intermediate cross frames",
      "target": [ { "level": "assembly", "category": "cross frame" } ] },
    { "id": "field-splice", "sheets": "^FIELD SPLICE DETAILS", "basis": "Field splice schedule and details (locations along each girder)",
      "target": [ { "level": "assembly", "category": [ "field splice", "girder field section" ] } ] },
    { "id": "camber-blocking", "sheets": "^CAMBER AND BLOCKING", "role": "general", "basis": "Camber, deflection ordinates (incl. the deflecting pier 2) and blocking per girder (girder-line data: context for the girder, not a detail sheet of its plates / studs / stiffeners)",
      "target": [ { "level": "group", "category": "girder" } ] },
    { "id": "haunch", "sheets": "^FIELD HAUNCH DATA", "role": "general", "basis": "Girder line haunch elevations and allowances (girder-line data: context for the girder and the deck slab, not a detail sheet of its plates / studs / stiffeners)",
      "target": [ { "level": "element", "category": "deck slab" }, { "level": "group", "category": "girder" } ] },
    { "id": "bearings", "sheets": "^DISC BEARING DETAILS", "role": "general", "basis": "Disc bearings (vendor designed): data table, anchor bolts, pier 2 cap bearings",
      "target": [ { "level": "assembly", "category": "bearing" } ] },
    { "id": "deck", "sheets": "^DECK (PLAN|REINFORCING)", "basis": "Deck plan, placement sections, reinforcing, rail bump-out locations, deck concrete quantity tables",
      "target": [ { "level": "part", "category": "deck" }, { "level": "element", "category": "deck slab" }, { "level": "group", "category": "deck reinforcing" },
                 { "level": "bar", "category": "rebar", "mark": [ "5d2", "5e5", "5e6" ] } ] },
    { "id": "top-of-deck", "sheets": "^TOP OF DECK ELEVATIONS", "basis": "Top of deck elevations (9 lines x 67 points)",
      "target": [ { "level": "part", "category": "deck" }, { "level": "element", "category": "deck slab" } ] },
    { "id": "joints", "sheets": "^EXPANSION DEVICE", "basis": "Steel extrusion joint with neoprene gland (std 1026)",
      "target": [ { "level": "part", "category": "deck" } ] },
    { "id": "barrier", "sheets": "^BARRIER RAIL DETAILS", "basis": "Iowa aesthetic barrier: sections, bump-outs, bar lists",
      "target": [ { "level": "group", "category": "barrier group" }, { "level": "element", "category": "barrier" } ] },
    { "id": "barrier-treatment", "sheets": "^BARRIER RAIL DETAILS - WEST RAIL", "basis": "Part sections C-C / F-F (concrete texture), D-D / H-H (thin veneer brick on the bump-outs)",
      "target": [ { "level": "element", "category": "form liner", "name": "%barrier%" }, { "level": "element", "category": "thin brick", "name": "%bump-out%" } ] },
    { "id": "texture", "sheets": "^CONCRETE TEXTURE & RUSTICATION DETAILS", "basis": "Concrete texture and rustication",
      "target": [ { "level": "group", "category": "surface treatment", "name": "%texture%" }, { "level": "element", "category": "form liner" } ] }
  ],

