  // Plan sheet links of the Nebraska St. Ramp B model (Iowa DOT Design 1617, File 30377; the PDF is named "B00167 - Nebraska Ramp B - Design 116.pdf").
  // Format: see sheet-links-i80-rampg.json (header) and docs/API.md "Companion database". Sheet index: docs/plan-data/nebraska-ramp-b-b00167/INDEX.md
  // (PDF page p = sheet number p; design sheet = p - 1 for pages 2-66; 67-70 soil profile sheets, 71 packaging overview).
  // Hierarchy in this model: bridge > superstructure > girder G1-G4 (field sections, field splices, bearings) | cross frame group | integral steel cap group
  //   "Integral steel pier cap CAP2" (assembly "integral steel pier cap" = twin I members, stiffeners, cover plates, handhole covers / backing plates,
  //   end screens, studs; assemblies "pier cap connection" per girder = connector / diaphragm / mill-to-bear plates, top splice plates, fills, bolts; the two
  //   cap bearings); end plates are parts of the girder field sections; bridge > deck > slab / barriers; substructure > Pier 1 (cap, pedestals, maskwalls = the cap end walls of p.9 / p.14,
  //   columns, footings, piles), Pier 2 (no cap: pedestals, turned columns, footings, piles), stub abutments; surface treatment groups (thin brick, texture).
  "models": [ "Nebraska St Ramp B.sbm" ],
  "planFolders": [ "plans", "C:/SBMData" ],

