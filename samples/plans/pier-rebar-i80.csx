double In_(double v) => In(v);
// plan bend diagram of the mark (optional fields "S=shape:d1,d2,..:pin" in inches; hairpins also "Z=stations per zone,..;M=margin"): see PlanBarGroup.Shape
PlanBarGroup Sh(PlanBarGroup g, string[] t)
{
    var e = t.FirstOrDefault(x => x.StartsWith("S="));
    if (e == null) return g;
    var q = e.Substring(2).Split(':');
    g.Shape = q[0]; g.Dims = q[1].Split(',').Select(x => In_(double.Parse(x))).ToArray(); g.Pin = q.Length > 2 ? In_(double.Parse(q[2])) : 0;
    var z = t.FirstOrDefault(x => x.StartsWith("Z="));
    if (z != null) g.ZoneStations = z.Substring(2).Split(',').Select(int.Parse).ToArray();
    var mg = t.FirstOrDefault(x => x.StartsWith("M="));
    if (mg != null) g.ZoneMargin = In_(double.Parse(mg.Substring(2)));
    var en = t.FirstOrDefault(x => x.StartsWith("E="));
    if (en != null) g.End = int.Parse(en.Substring(2));
    return g;
}
int done = 0;
foreach (var b in Doc.Project.Bridges)
    foreach (var sup in b.Supports.Concat(b.AuxiliarySupports))
    {
        var sd = sup.Substructure;
        if (sd == null || sd.CapProfile == null || sd.CapProfile.Count < 3 || !P.TryGetValue(sup.Name, out var d)) continue;
        int nf = Math.Max(1, sd.Footings.Count);
        // ---- cap
        sd.Reinforcement.CapBars = d.cap.Select(line =>
        {
            var t = line.Split(';');
            return Sh(new PlanBarGroup
            {
                Mark = t[0], Kind = Enum.Parse<PlanBarKind>(t[1]), Size = t[2], Count = int.Parse(t[3]), Length = In_(double.Parse(t[4])), Vertical = t[5] == "1",
            }, t);
        }).ToList();
        // ---- footings
        for (int k = 0; k < sd.Footings.Count; k++)
        {
            var fd = sd.Footings[k];
            fd.Bars = new();
            foreach (var line in d.foot)
            {
                var t = line.Split(';');
                int total = int.Parse(t[3]);
                int cnt = (int)Math.Round(total * (k + 1.0) / nf) - (int)Math.Round(total * (double)k / nf);
                if (cnt <= 0) continue;
                fd.Bars.Add(Sh(new PlanBarGroup
                {
                    Mark = t[0], Kind = Enum.Parse<PlanBarKind>(t[1]), Size = t[2], Count = cnt, Length = In_(double.Parse(t[4])),
                    Top = t[5] == "1", Order = int.Parse(t[6]), AlongN = t[7] == "1", HookExtra = In_(double.Parse(t[8])),
                }, t));
            }
            // circled piles: the ring symbols read from the pile layout sheet (vector circles mapped to the pile they surround)
            var up = fd.Bars.FirstOrDefault(g => g.Kind == PlanBarKind.UpliftAnchor);
            fd.UpliftPiles = new();
            if (up != null)
            {
                var rk = k < d.rings.Length ? d.rings[k] : new (double s, double n)[0];
                foreach (var r in rk)
                {
                    int j = Enumerable.Range(0, fd.Piles.Count).OrderBy(i => Math.Pow(fd.Piles[i].S - Ft(r.s), 2) + Math.Pow(fd.Piles[i].N - Ft(r.n), 2)).FirstOrDefault(-1);
                    if (j >= 0 && Math.Sqrt(Math.Pow(fd.Piles[j].S - Ft(r.s), 2) + Math.Pow(fd.Piles[j].N - Ft(r.n), 2)) < Ft(1) && !fd.UpliftPiles.Contains(j)) fd.UpliftPiles.Add(j);
                }
                if (fd.UpliftPiles.Count != rk.Length) Print($"  WARNING {sup.Name} footing {fd.Column}: {rk.Length} circled piles read from the sheet, {fd.UpliftPiles.Count} matched a pile.");
                // 3 anchors per circled pile; the footing's share of the bar list is the number of circled piles x 3 (the bar list total reconciles)
                up.Count = fd.UpliftPiles.Count * fd.UpliftBarsPerPile;
                if (up.Count == 0) fd.Bars.Remove(up);
            }
        }
        done++;
    }
Print($"{done} piers given plan footing / cap reinforcing.");
var res = Doc.Regenerate();
Print($"regenerated {res.Bridges} bridges in {res.Elapsed.TotalSeconds:F1} s, {res.Errors.Count} errors.");
foreach (var e in res.Errors) Print("  ERROR " + e);
Doc.Save();
