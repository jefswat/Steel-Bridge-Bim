{
  // Rules linking model elements to the plan sheets they are based on (companion database, tables sheets / element_sheet).
  // models          = the .sbm files these rules belong to (the app and `sbm db` pick the sheet-links*.json beside the model that names it).
  // planFolders     = extra folders for the plan PDFs (relative to this file); the PDF is only needed for Open PDF / --pages.
  // planSets[].sheets = the sheet index { p: PDF page, s: design sheet, t: title }: fills the sheets table on every build (no PDF split).
  // rules[].sheets  = regex on the normalized sheet title (case-insensitive; named groups become {name} below)
  // rules[].pages   = optional list of PDF pages the rule is limited to (sheets sharing a title)
  // rules[].target  = OR of selectors; a selector is AND of elements columns: level, category, subtype, bridge, bridge_group,
  //                   unit, support, girder, mark, name.  Value = text ({captures}, % wildcard) or a list of texts.
  //                   bridge_group defaults to the plan set's bridge_group.
  // rules[].role    = "detail" (the element is drawn/dimensioned on the sheet) or "general" (context: notes, situation, staking).
  // A link is stored on the HIGHEST matching element only (e.g. a field-splice assembly); every child (plates, bolts) inherits it
  // through the hierarchy (view v_element_sheets). Sheets matching no rule are the "unused" sheets (what the model lacks).
  // Hierarchy of categories: unit(IfcBridge) > part(superstructure|deck|substructure) > group(girder|cross frame group|deck reinforcing|barrier group|joint) >
  //   assembly(girder field section|field splice|bearing|cross frame|cross girder|lateral bracing) > group(bolt group|stud group|weld group) > bolt/stud/part;
  //   substructure: part(pier|abutment) > group(cap group|column group|footing group|backwall group) > concrete elements and their bars.

  "models": [ "I-80 WB and Ramp G.sbm" ],
  // Plan PDFs: searched here (relative to this file), then beside the model, in %SBM_PLANS% and the program folder.
  "planFolders": [ "plans", "../../dist/SteelBridgeModeler", "C:/SBM/dist/SteelBridgeModeler" ],

