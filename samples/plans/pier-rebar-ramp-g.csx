        new string[] { "10a1;CapTop;#10;14;461.00;0", "10a2;CapTop;#10;14;411.00;0", "8a3;CapSide;#8;14;421.00;0", "8a4;CapSide;#8;2;384.00;0", "8a5;CapSide;#8;2;321.00;0", "8a6;CapSide;#8;2;260.00;0", "8a7;CapSide;#8;2;200.00;0", "5a8;CapSide;#5;4;424.00;0", "5a9;CapSide;#5;2;287.00;0", "5a10;CapSide;#5;2;233.00;0", "5a11;CapSide;#5;2;141.00;0", "5a12;CapSide;#5;2;451.00;0", "5a13;CapSide;#5;2;65.00;0", "6a14;CapEnd;#6;10;135.00;0", "6a15;CapEnd;#6;14;96.00;1", "8b1;CapBottom;#8;8;459.00;0", "6c1;CapHoop;#6;32;348.00;0", "6c2;CapCantileverHoop;#6;72;310.03;0", "5c3;CapHairpin;#5;26;165.00;0", "5c4;CapHairpin;#5;28;181.00;0", "4c5;CapTransverse;#4;16;98.00;0", "5m1;PedestalLongitudinal;#5;24;118.00;0", "5n1;PedestalTransverse;#5;24;122.00;0" },
        new (double s, double n)[][] { new (double s, double n)[] { (-14.00, 19.25), (-7.00, 19.25), (7.00, 19.25), (14.00, 19.25), (-14.00, 13.75), (14.00, 13.75), (-14.00, -13.75), (14.00, -13.75), (-14.00, -19.25), (-7.00, -19.25), (7.00, -19.25), (14.00, -19.25) } }),
    ["Pier 19G"] = (
        new string[] { "7f1;FootingMat;#7;28;260.00;1;1;1;0.00", "7f2;FootingMat;#7;29;332.00;1;2;0;0.00", "8f6;UpliftAnchor;#8;12;60.00;0;1;0;0.00", "11g1;FootingMat;#11;28;308.00;0;1;1;24.00", "11g2;FootingMat;#11;29;380.00;0;2;0;24.00" },
        new string[] { "10a1;CapTop;#10;14;522.00;0", "10a2;CapTop;#10;14;473.00;0", "8a3;CapSide;#8;14;482.00;0", "8a4;CapSide;#8;2;431.00;0", "8a5;CapSide;#8;2;356.00;0", "8a6;CapSide;#8;2;284.00;0", "8a7;CapSide;#8;2;212.00;0", "5a8;CapSide;#5;4;484.00;0", "5a9;CapSide;#5;2;335.00;0", "5a10;CapSide;#5;2;276.00;0", "5a11;CapSide;#5;2;174.00;0", "5a12;CapSide;#5;2;511.00;0", "5a13;CapSide;#5;2;68.00;0", "6a14;CapEnd;#6;10;135.00;0", "6a15;CapEnd;#6;14;96.00;1", "8b1;CapBottom;#8;8;512.00;0", "6c1;CapHoop;#6;32;348.00;0", "6c2;CapCantileverHoop;#6;40;310.99;0", "5c3;CapHairpin;#5;28;165.00;0", "5c4;CapHairpin;#5;34;181.00;0", "4c5;CapTransverse;#4;19;98.00;0", "6c6;CapCantileverHoop;#6;46;307.94;0", "5m1;PedestalLongitudinal;#5;28;136.00;0", "8m2;CapTop;#8;4;473.00;0", "5m3;CapSide;#5;2;473.00;0", "5n1;PedestalTransverse;#5;42;121.00;0", "6n2;CapTie;#6;40;107.00;0" },
        new (double s, double n)[][] { new (double s, double n)[] { (-12.00, 9.00), (12.00, 9.00), (-12.00, -9.00), (12.00, -9.00) } }),
};

double In_(double v) => In(v);
int done = 0;
foreach (var b in Doc.Project.Bridges)
    foreach (var sup in b.Supports.Concat(b.AuxiliarySupports))
    {
        var sd = sup.Substructure;
        if (sd == null || sd.CapProfile == null || sd.CapProfile.Count < 3 || !P.TryGetValue(sup.Name, out var d)) continue;
        int nf = Math.Max(1, sd.Footings.Count);
        // ---- cap
        sd.Reinforcement.CapBars = d.cap.Select(line =>
        {
            var t = line.Split(';');
            return new PlanBarGroup
            {
                Mark = t[0], Kind = Enum.Parse<PlanBarKind>(t[1]), Size = t[2], Count = int.Parse(t[3]), Length = In_(double.Parse(t[4])), Vertical = t[5] == "1",
            };
        }).ToList();
        // ---- footings
        for (int k = 0; k < sd.Footings.Count; k++)
        {
            var fd = sd.Footings[k];
            fd.Bars = new();
            foreach (var line in d.foot)
            {
                var t = line.Split(';');
                int total = int.Parse(t[3]);
                int cnt = (int)Math.Round(total * (k + 1.0) / nf) - (int)Math.Round(total * (double)k / nf);
                if (cnt <= 0) continue;
                fd.Bars.Add(new PlanBarGroup
                {
                    Mark = t[0], Kind = Enum.Parse<PlanBarKind>(t[1]), Size = t[2], Count = cnt, Length = In_(double.Parse(t[4])),
                    Top = t[5] == "1", Order = int.Parse(t[6]), AlongN = t[7] == "1", HookExtra = In_(double.Parse(t[8])),
                });
            }
            // circled piles: the ring symbols read from the pile layout sheet (vector circles mapped to the pile they surround)
            var up = fd.Bars.FirstOrDefault(g => g.Kind == PlanBarKind.UpliftAnchor);
            fd.UpliftPiles = new();
            if (up != null)
            {
                var rk = k < d.rings.Length ? d.rings[k] : new (double s, double n)[0];
                foreach (var r in rk)
                {
                    int j = Enumerable.Range(0, fd.Piles.Count).OrderBy(i => Math.Pow(fd.Piles[i].S - Ft(r.s), 2) + Math.Pow(fd.Piles[i].N - Ft(r.n), 2)).FirstOrDefault(-1);
                    if (j >= 0 && Math.Sqrt(Math.Pow(fd.Piles[j].S - Ft(r.s), 2) + Math.Pow(fd.Piles[j].N - Ft(r.n), 2)) < Ft(1) && !fd.UpliftPiles.Contains(j)) fd.UpliftPiles.Add(j);
                }
                if (fd.UpliftPiles.Count != rk.Length) Print($"  WARNING {sup.Name} footing {fd.Column}: {rk.Length} circled piles read from the sheet, {fd.UpliftPiles.Count} matched a pile.");
                // 3 anchors per circled pile; the footing's share of the bar list is the number of circled piles x 3 (the bar list total reconciles)
                up.Count = fd.UpliftPiles.Count * fd.UpliftBarsPerPile;
                if (up.Count == 0) fd.Bars.Remove(up);
            }
        }
        done++;
    }
Print($"{done} piers given plan footing / cap reinforcing.");
var res = Doc.Regenerate();
Print($"regenerated {res.Bridges} bridges in {res.Elapsed.TotalSeconds:F1} s, {res.Errors.Count} errors.");
foreach (var e in res.Errors) Print("  ERROR " + e);
Doc.Save();
