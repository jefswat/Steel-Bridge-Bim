  "administrative": [],

  "rules": [
    { "id": "general-plan", "sheets": "^GENERAL PLAN AND ELEVATION", "role": "general",
      "basis": "Curve no. 9 (R 881.47 LT), profile (PVI 302+70, VC 200'), spans 139'-3 3/8 / 161'-0 / 161'-0, station equations, design data",
      "target": [ { "level": "alignment", "bridge_group": "CL Ramp 44F" }, { "level": "unit" } ] },
    { "id": "staking", "sheets": "^STAKING LAYOUT", "role": "general", "basis": "Working points (N / E) of piers 14-16 and abutment 1: the arc centre of curve no. 9",
      "target": [ { "level": "alignment", "bridge_group": "CL Ramp 44F" }, { "level": "unit" } ] },
    { "id": "pier13-wp", "sheets": "^SUBSTRUCTURE LAYOUT \\(BRIDGE N", "role": "general", "basis": "Pier 13 working point (Ramp 44E STA 301+09.58 = 44F 301+53.72); its N / E is not on the 44F arc (UNRESOLVED)",
      "target": [ { "level": "alignment", "bridge_group": "CL Ramp 44F" } ] },
    { "id": "pedestals-13", "sheets": "^PIER NO\\. 13 EAST DETAILS", "basis": "Pedestal elevations 4 / 5 (G2 / G1 seats at pier 13), checked against the bearing seats",
      "target": [ { "level": "assembly", "category": "bearing", "name": "B1-%" } ] },
    { "id": "pedestals-14", "sheets": "^PIER NO\\. 14 DETAILS", "pages": [ 262 ], "basis": "Pedestal elevations (G1 / G2 seats), anchor bolt layout",
      "target": [ { "level": "assembly", "category": "bearing", "name": "B2-%" } ] },
    { "id": "pedestals-15", "sheets": "^PIER NO\\. 15 DETAILS", "pages": [ 264 ], "basis": "Pedestal elevations (G1 / G2 seats), anchor bolt layout",
      "target": [ { "level": "assembly", "category": "bearing", "name": "B3-%" } ] },
    { "id": "pedestals-16", "sheets": "^PIER NO\\. 16 DETAILS", "pages": [ 266 ], "basis": "Pedestal elevations 1 / 2 (span 16 seats), anchor bolt layout",
      "target": [ { "level": "assembly", "category": "bearing", "name": "B4-%" } ] },

    { "id": "typical-section", "sheets": "^SUPERSTRUCTURE DETAILS", "pages": [ 270 ], "basis": "Typical section: 8 in. slab, 32'-0 deck, 6 % cross slope, tub spacing, F-shaped parapets",
      "target": [ { "level": "part", "category": [ "superstructure", "deck" ] }, { "level": "group", "category": "barrier group" } ] },
    { "id": "bearing-height", "sheets": "^SUPERSTRUCTURE DETAILS", "pages": [ 271 ], "basis": "'H' (top of slab to bottom of bearing assembly) at the supports (the deck bar list on this sheet is not entered in the model)",
      "target": [ { "level": "assembly", "category": "bearing" } ] },
    { "id": "pour-sequence", "sheets": "^SUPERSTRUCTURE DETAILS", "pages": [ 272 ], "basis": "Slab pour sequence (sections 1 / 3 / 2 / 3 / 1; data only, the slab is not split)",
      "target": [ { "level": "element", "category": "deck slab" } ] },
    { "id": "framing-plan", "sheets": "^FRAMING PLAN", "basis": "Girder radii, bearing lines, bracing panel strings, external diaphragms, field splices, access hatches",
      "target": [ { "level": "group", "category": [ "girder", "cross frame group", "lateral bracing group" ] } ] },
    { "id": "girder-1", "sheets": "^STEEL GIRDER ELEVATION \\(SPANS NO\\. 14-16 - GIRDER NO\\. 1\\)", "basis": "Girder 1 plates, splices, tension zones, studs",
      "target": [ { "level": "group", "category": "girder", "girder": "G1" } ] },
    { "id": "girder-2", "sheets": "^STEEL GIRDER ELEVATION \\(SPANS NO\\. 14-16 - GIRDER NO\\. 2\\)", "basis": "Girder 2 plates, splices, tension zones, studs",
      "target": [ { "level": "group", "category": "girder", "girder": "G2" } ] },
    // QC back-check I14 (qc/odot-o): the girder field sections carried only p.290 (misc), so the flange / web plates and the studs of a field section did not
    // link the elevation sheets that define their sizes and stud rows. The field sections of each girder now link p.278 (G1) / p.279 (G2) as well.
    { "id": "girder-1-sections", "sheets": "^STEEL GIRDER ELEVATION \\(SPANS NO\\. 14-16 - GIRDER NO\\. 1\\)", "basis": "Girder 1 field section plates (widths, thicknesses, lengths), stud spacing rows, tension zones",
      "target": [ { "level": "assembly", "category": "girder field section", "name": "G1-%" } ] },
    { "id": "girder-2-sections", "sheets": "^STEEL GIRDER ELEVATION \\(SPANS NO\\. 14-16 - GIRDER NO\\. 2\\)", "basis": "Girder 2 field section plates (widths, thicknesses, lengths), stud spacing rows, tension zones",
      "target": [ { "level": "assembly", "category": "girder field section", "name": "G2-%" } ] },
    { "id": "framing-plan-bracing", "sheets": "^FRAMING PLAN", "basis": "Panel points (n EQ. SPA. strings), solid / dashed bracing lines, bold radial external diaphragm lines, support diaphragm lines and bearing lines that place the bracing assemblies",
      "target": [ { "level": "assembly", "category": [ "cross frame", "lateral bracing" ] } ] },
    { "id": "deflections", "sheets": "^STEEL GIRDER DEAD LOAD DEFLECTIONS", "basis": "Dead load deflections at the tenth points and splices (camber input)",
      "target": [ { "level": "group", "category": "girder" } ] },
    { "id": "field-splices", "sheets": "^FIELD SPLICE DETAILS", "basis": "Top / web / bottom splice plates, fillers, 1 in. A325 bolts",
      "target": [ { "level": "assembly", "category": "field splice" } ] },
    { "id": "intermediate-bracing", "sheets": "^INTERMEDIATE CROSS FRAME DETAILS", "basis": "Internal K frames, WT6x29 top struts, transverse stiffeners, external intermediate diaphragms",
      "target": [ { "level": "assembly", "category": "cross frame", "name": [ "G%-K%", "G%-T%", "XD%" ] } ] },
    { "id": "end-diaphragm-13", "sheets": "^PIER NO\\. 13 END DIAPHRAGM DETAILS", "basis": "Pier 13 interior / exterior end diaphragms, bearing stiffeners, bent plates",
      "target": [ { "level": "assembly", "category": "cross frame", "name": [ "G%-SD1", "XSD1-%" ] } ] },
    { "id": "end-diaphragm-16", "sheets": "^PIER NO\\. 16 END DIAPHRAGM DETAILS", "basis": "Pier 16 interior / exterior end diaphragms, bearing stiffeners",
      "target": [ { "level": "assembly", "category": "cross frame", "name": [ "G%-SD4", "XSD4-%" ] } ] },
    { "id": "pier-diaphragms", "sheets": "^PIERS NO\\. 14 & 15 PIER DIAPHRAGM DETAILS", "basis": "Piers 14 / 15 interior diaphragms (access opening), exterior diaphragms, bearing stiffeners",
      "target": [ { "level": "assembly", "category": "cross frame", "name": [ "G%-SD2", "G%-SD3", "XSD2-%", "XSD3-%" ] } ] },
    { "id": "lateral-bracing", "sheets": "^LATERAL BRACING DETAIL", "basis": "WT9x38 top lateral bracing, work points, end bolts",
      "target": [ { "level": "assembly", "category": "lateral bracing" } ] },
    { "id": "misc", "sheets": "^STEEL GIRDER MISCELLANEOUS DETAILS", "basis": "Access doors, studs (3 - 7/8 x 7), drain holes, rodent screens, drip plates",
      "target": [ { "level": "assembly", "category": "girder field section" } ] },
    { "id": "bearings", "sheets": "^STEEL GIRDER BEARING (DETAILS|ASSEMBLY SCHEDULES)", "basis": "Laminated pads, beveled plates (bevels M / N), anchor bolts",
      "target": [ { "level": "assembly", "category": "bearing" } ] },
    { "id": "parapet", "sheets": "^SUPERSTRUCTURE DETAILS", "pages": [ 270, 271 ], "basis": "42 in. F-shaped parapet (std FSHP-42, not in the volume)",
      "target": [ { "level": "element", "category": "barrier" } ] }
