{
  // Plan sheet links of the ODOT Bridge O steel tub unit model (Vol 2 Phase 2B, job piece 09033(11); Bridge 'O' = Ramp 44F over I-44 &
  // Ramps 44N / 44M2, spans 14-16 = 2 steel tub girders; build-odot-o-tub.csx). Format: see sheet-links-i80-rampg.json (header) and
  // docs/API.md "Companion database". Sheet index: docs/plan-data/vol2-sheet-index.csv and vol2-o-steel-tub-unit-spans14-16/INDEX.md, titles read
  // from the title blocks (PDF pages 254-300 = Bridge O sheets O-1 .. O-43, BD-1, PS-1/2; p.148 / p.180 = Bridge N sheets with the pier 13 data).
  // Scope (user): superstructure of spans 14-16 only - substructure, abutment, span 17 (U54 beams), approach slab, slope wall, drains are NOT
  // modeled; their sheets have no rule and show as unused sheets.
  // Hierarchy in this model: unit > superstructure > girder (G1, G2) > girder field section G#-n | field splice FS#-G# | bearing B#-G# (B1 = pier 13,
  //   B2 = pier 14, B3 = pier 15, B4 = pier 16) | cross frame (G#-K s.n internal K frame + top strut, G#-T s.n top strut, XD# external diaphragm,
  //   G#-SD# interior support diaphragm, XSD#-1 exterior support diaphragm; # = support 1-4 = piers 13-16) | lateral bracing G#-LAT s;
  //   unit > deck > deck slab, barrier group > barrier.

  "models": [ "ODOT Bridge O tub unit.sbm" ],
  "planFolders": [ "plans", "C:/SBMData" ],

