{
  // Plan sheet links of the Br02069 model (MnDOT Br. 02069, T.H. 65 S.B. over 117th Ave; one span, seven 30MH PPC beams).
  // Format: see sheet-links-i80-rampg.json (header) and docs/API.md "Companion database". Sheet index and families:
  // docs/plan-data/br02069-th65/INDEX.md (PDF page = sheet number for all 39 pages). The titles are written here because the
  // split tool's title-block reader (Iowa DOT blocks) does not read the MnDOT / HDR title box.
  // Hierarchy in this model: unit > superstructure > prestressed girder (assembly: beam, strands, debond sheathing) | bearing pad;
  //   unit > deck > deck slab, barrier group > barrier; unit > substructure > abutment > cap group (pedestals / beam steps) |
  //   backwall group | footing group (footing, piles) | maskwall group; plan bars: abutment bars under the abutment, deck reinforcing / diaphragm
  //   reinforcing under the deck, barrier reinforcing under the barrier group. Concrete end diaphragms (solids) are not in the database yet.

  "models": [ "Br02069 TH65.sbm" ],
  "planFolders": [ "plans", "C:/SBMData" ],

  "planSets": [
    { "id": "br02069", "pdf": "Br02069*.pdf", "bridgeGroup": "Br02069 TH65 SB",
      "sheets": [
        { "p": 1, "s": "1", "t": "GENERAL PLAN AND ELEVATION" },
        { "p": 2, "s": "2", "t": "TRANSVERSE SECTION, CONSTRUCTION NOTES & SOQ" },
        { "p": 3, "s": "3", "t": "BRIDGE LAYOUT" },
        { "p": 4, "s": "4", "t": "SOUTH ABUTMENT DETAILS 1" },
        { "p": 5, "s": "5", "t": "SOUTH ABUTMENT DETAILS 2" },
        { "p": 6, "s": "6", "t": "SOUTH ABUTMENT REINFORCEMENT 1" },
        { "p": 7, "s": "7", "t": "SOUTH ABUTMENT REINFORCEMENT 2" },
        { "p": 8, "s": "8", "t": "SOUTH ABUTMENT REINFORCEMENT 3" },
        { "p": 9, "s": "9", "t": "NORTH ABUTMENT DETAILS 1" },
