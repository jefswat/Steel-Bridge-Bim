        { "p": 37, "s": "37", "t": "ALIGNMENT TABULATION 2" },
        { "p": 38, "s": "38", "t": "INPLACE TOPOGRAPHY AND UTILITIES" },
        { "p": 39, "s": "39", "t": "BORINGS" }
      ] }
  ],

  "administrative": [ "^AS-BUILT BRIDGE DATA" ],

  "rules": [
    { "id": "general-plan", "sheets": "^GENERAL PLAN AND ELEVATION", "role": "general", "basis": "General plan and elevation, design data, list of sheets",
      "target": [ { "level": "unit" }, { "level": "alignment", "bridge_group": "SB65" } ] },
    { "id": "transverse-section", "sheets": "^TRANSVERSE SECTION", "basis": "Transverse section: deck, beam spacing, barrier; construction notes and quantities",
      "target": [ { "level": "part", "category": "deck" }, { "level": "assembly", "category": "prestressed girder" } ] },
    { "id": "transverse-section-notes", "sheets": "^TRANSVERSE SECTION", "role": "general", "basis": "Construction notes and schedule of quantities",
      "target": [ { "level": "unit" } ] },
    { "id": "layout", "sheets": "^BRIDGE LAYOUT", "basis": "Bridge layout: working points, top of roadway to seat",
      "target": [ { "level": "part", "category": [ "superstructure", "abutment" ] } ] },

    { "id": "abutment-details", "sheets": "^(?<n>SOUTH|NORTH) ABUTMENT (DETAILS|REINFORCEMENT)", "basis": "{n} abutment: cap, backwall, beam seats, piles and reinforcing",
      "target": [ { "level": "part", "category": "abutment", "support": "{n} Abutment" } ] },
    { "id": "abutment-common", "sheets": "^ABUTMENT DETAILS", "basis": "Abutment details common to both abutments",
      "target": [ { "level": "part", "category": "abutment" } ] },

    { "id": "framing-plan", "sheets": "^FRAMING PLAN", "basis": "Framing plan: beam lines, bearings, diaphragms",
      "target": [ { "level": "part", "category": "superstructure" } ] },
    { "id": "beam", "sheets": "^30MH PRESTRESSED CONCRETE BEAM", "basis": "30MH beam: section, strand pattern, debonding",
      "target": [ { "level": "assembly", "category": "prestressed girder" } ] },
    { "id": "diaphragm-connection", "sheets": "^PRESTRESSED CONCRETE BEAM DIAPHRAGM CONNECTION", "basis": "Beam / end diaphragm connection (inserts in the beams)",
      "target": [ { "level": "assembly", "category": "prestressed girder" } ] },
    { "id": "superstructure", "sheets": "^SUPERSTRUCTURE DETAILS", "basis": "Deck, end diaphragms, deck reinforcing and bar list",
      "target": [ { "level": "part", "category": "deck" } ] },
    { "id": "diaphragm-rebar", "sheets": "^SUPERSTRUCTURE DETAILS [34]", "basis": "End diaphragm reinforcing: plan / elevation (sheet 20), sections A-A / B-B and bill (sheet 21)",
      "target": [ { "level": "group", "category": "diaphragm reinforcing" } ] },
    { "id": "abutment-section-semi-integral", "sheets": "^SUPERSTRUCTURE DETAILS 4", "basis": "Section A-A / B-B: semi-integral end diaphragm on the abutment stem (back ledge, seat, polystyrene)",
      "target": [ { "level": "part", "category": "abutment" } ] },

    { "id": "barrier", "sheets": "^(BARRIER LAYOUT|CONCRETE BARRIER|MISCELLANEOUS CONCRETE BARRIER|BRIDGE DETAILS 4)", "basis": "Concrete barrier: layout, profile, reinforcing",
      "target": [ { "level": "group", "category": "barrier group" } ] },
    { "id": "barrier-cover-plate", "sheets": "^BRIDGE APPROACH PANEL BARRIER", "role": "general", "basis": "Barrier end at the approach panel (cover plate; not modeled)",
      "target": [ { "level": "group", "category": "barrier group" } ] },
    { "id": "pile-splice", "sheets": "^BRIDGE DETAILS 1", "basis": "Standard pile splice (B201)",
      "target": [ { "level": "element", "category": "pile" } ] },
    { "id": "bearings-b303", "sheets": "^BRIDGE DETAILS 2", "basis": "Sole plate (B303) and pad restraint (B307)",
      "target": [ { "level": "element", "category": "bearing pad" } ] },
    { "id": "bearings-b311", "sheets": "^BRIDGE DETAILS 3", "basis": "Plate bearing assemblies (B310 fixed / B311 expansion)",
      "target": [ { "level": "element", "category": "bearing pad" } ] },
    { "id": "bearings-framing", "sheets": "^FRAMING PLAN", "basis": "Bearing types and locations",
      "target": [ { "level": "element", "category": "bearing pad" } ] },

    { "id": "survey", "sheets": "^(BRIDGE SURVEY|ALIGNMENT TABULATION 1)", "role": "general", "basis": "Survey and alignment tabulation (SB65)",
      "target": [ { "level": "alignment", "bridge_group": "SB65" } ] },
    { "id": "borings", "sheets": "^BORINGS", "role": "general", "basis": "Borings (pile design basis)",
      "target": [ { "level": "group", "category": "footing group" } ] }
  ],

  "hints": [
    { "sheets": "PIPE RAILING", "suggests": "Pipe railing on the barrier: not modeled." },
    { "sheets": "LIGHTING", "suggests": "Underpass lighting: not modeled." },
    { "sheets": "SLOPE PAVING", "suggests": "Concrete slope paving under the bridge: no slope-protection elements." },
    { "sheets": "PROFILES|ALIGNMENT TABULATION 2", "suggests": "Profiles / alignments of the roads under the bridge (117th Ave, ramps): not in the model." },
    { "sheets": "TOPOGRAPHY", "suggests": "Existing topography and utilities: no terrain / utility elements in this model." }
  ]
}
