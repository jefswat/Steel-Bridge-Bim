        { "p": 17, "s": "17", "t": "PRESTRESSED CONCRETE BEAM DIAPHRAGM CONNECTION DETAILS (FIG. 5-397.560)" },
        { "p": 18, "s": "18", "t": "SUPERSTRUCTURE DETAILS 1" },
        { "p": 19, "s": "19", "t": "SUPERSTRUCTURE DETAILS 2" },
        { "p": 20, "s": "20", "t": "SUPERSTRUCTURE DETAILS 3" },
        { "p": 21, "s": "21", "t": "SUPERSTRUCTURE DETAILS 4" },
        { "p": 22, "s": "22", "t": "BARRIER LAYOUT" },
        { "p": 23, "s": "23", "t": "PIPE RAILING DETAILS" },
        { "p": 24, "s": "24", "t": "CONCRETE BARRIER 36\" TYPE S (FIG. 5-397.138(A) MOD.)" },
